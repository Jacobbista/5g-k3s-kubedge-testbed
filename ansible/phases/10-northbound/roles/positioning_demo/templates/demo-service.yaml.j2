apiVersion: v1
kind: Service
metadata:
  name: location-app
  namespace: {{ demo_namespace }}
  labels:
    app: location-app
spec:
  selector:
    app: location-app
  ports:
    - protocol: TCP
      port: 80
      targetPort: 80
      nodePort: {{ positioning_demo_nodeport }}
      name: http
  type: NodePort
