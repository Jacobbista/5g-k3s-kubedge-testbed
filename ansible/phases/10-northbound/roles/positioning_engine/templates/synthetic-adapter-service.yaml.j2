apiVersion: v1
kind: Service
metadata:
  name: synthetic-adapter
  namespace: {{ positioning_namespace }}
  labels:
    app: synthetic-adapter
spec:
  selector:
    app: synthetic-adapter
  ports:
    - protocol: TCP
      port: 8080
      targetPort: 8080
      name: http
  # ClusterIP only: the engine reaches it over in-cluster DNS. Not externally exposed.
  type: ClusterIP
